# ─── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://royalfitness.com

# ─── Contact / WhatsApp ──────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=919730091331
NEXT_PUBLIC_CONTACT_EMAIL=hello@royalfitness.com

# ─── Firebase (required) ─────────────────────────────────────────────────
# Without these the app falls back to an offline localStorage mock and no
# data is persisted. Values are public by design (they identify the project,
# they don't authorise anything) — access control lives in firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Admin ───────────────────────────────────────────────────────────────
# Bootstrap administrator address, matched EXACTLY (never as a substring).
# Changing it here is only half the job: adminEmail() in firestore.rules must
# be updated to the same value, or the rules will keep enforcing the old one.
# Everyone else becomes an admin via role:"admin" on their users/{uid} document,
# which only an existing admin can set.
NEXT_PUBLIC_ADMIN_EMAIL=admin@royalfitness.com

# ─── Service account (server-side only — NEVER prefix with NEXT_PUBLIC_) ──
# Grants full project access, bypassing firestore.rules. Required for creating
# and deleting member accounts (/api/admin/members); without it those routes
# return 503 and the rest of the app is unaffected.
#
# Firebase Console → Project settings → Service accounts → Generate new private
# key. Paste the JSON on one line, or base64-encode it if your host mangles the
# newlines in the private key:
#   base64 -w0 serviceAccount.json
FIREBASE_SERVICE_ACCOUNT=

# ─── Maps ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# ─── Future integrations (placeholders — not required to run) ─────────────
# Payments
NEXT_PUBLIC_RAZORPAY_KEY_ID=
STRIPE_SECRET_KEY=
